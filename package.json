{
  "name": "pnpm-mirror",
  "version": "0.0.0",
  "description": "Fetch pnpm deps and produce a manifest for nixpkgs mitm-cache",
  "license": "MIT",
  "author": "Sefa Eyeoglu <contact@scrumplex.net>",
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@pnpm/deps.path": "^1101.0.0",
    "@pnpm/lockfile.fs": "^1100.1.4",
    "p-map": "^7.0.4",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest --root src/ --watch false",
    "dev": "tsx src/index.ts"
  },
  "files": [
    "dist/*.js"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
