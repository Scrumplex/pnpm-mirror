{
  "name": "pnpm-mirror",
  "version": "0.0.0",
  "description": "Fetch pnpm deps and produce a manifest for nixpkgs mitm-cache",
  "license": "MIT",
  "author": "Sefa Eyeoglu <contact@scrumplex.net>",
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@logtape/logtape": "^2.1.4",
    "@pnpm/deps.path": "^1100.0.7",
    "@pnpm/lockfile.fs": "^1100.1.4",
    "p-map": "^7.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-mocha": "^12.0.2",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "mocha": "^12.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "mocha --require tsx --extension spec.ts src/",
    "dev": "tsx src/index.ts"
  },
  "files": [
    "dist/*.js"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
